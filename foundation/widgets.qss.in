/* Generated by foundation/generate.py. Edit foundation/widgets.qss.in.
 * ${theme} — Fluent Foundation for TeamSpeak 3.6.x (Qt 5.15).
 * Leave the root QWidget background unset so nested widgets, tree items,
 * and rich-text cells inherit the surface that contains them.
 * TS3 reads QPalette roles from comments, including the chat link colour.
 *
 * QPalette::Window = ${bgCanvas};
 * QPalette::WindowText = ${textPrimary};
 * QPalette::Base = ${bgSurface};
 * QPalette::AlternateBase = ${bgSidebar};
 * QPalette::Text = ${textPrimary};
 * QPalette::Button = ${bgControl};
 * QPalette::ButtonText = ${textPrimary};
 * QPalette::BrightText = #FFFFFF;
 * QPalette::Highlight = ${selectionBg};
 * QPalette::HighlightedText = ${selectionText};
 * QPalette::Link = ${accent};
 * QPalette::LinkVisited = ${accent};
 * QPalette::ToolTipBase = ${bgTooltip};
 * QPalette::ToolTipText = ${textTooltip};
 * QPalette::PlaceholderText = ${textTertiary};
 * QPalette::Mid = ${strokeControl};
 * QPalette::Midlight = ${strokeDivider};
 * QPalette::Dark = ${strokeDivider};
 * QPalette::Light = ${strokeHover};
 * QPalette::Shadow = #000000;
 */

/* ------------------------------------------------------------------ */
/* Base                                                                */
/* ------------------------------------------------------------------ */

QWidget {
	/* YaHei UI first: it is the only family here that covers both Latin and
	   CJK with matching metrics, so mixed-language channel names stay even. */
	font-family: "${fontFamily}";
	font-size: ${bodySize}px;
	color: ${textPrimary};
	selection-background-color: ${fillSelected};
	selection-color: ${textPrimary};
}

/* Give text selection stronger contrast than a selected row. */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
	selection-background-color: ${selectionBg};
	selection-color: ${selectionText};
}

QMainWindow, QDialog, QStackedWidget, QTabWidget, QSplitter {
	background-color: ${bgCanvas};
}

QLabel {
	background: transparent;
	color: ${textPrimary};
}

QLabel:disabled {
	color: ${textDisabled};
}

QToolTip {
	background-color: ${bgTooltip};
	color: ${textTooltip};
	border: 1px solid ${strokeOverlay};
	border-radius: ${radiusOverlay}px;
	font-size: ${captionSize}px;
	padding: ${gapTight}px ${gapNormal}px;
}

/* ------------------------------------------------------------------ */
/* Splitters                                                           */
/* ------------------------------------------------------------------ */

QSplitter::handle {
	background: transparent;
}

QSplitter::handle#bookmarksLocalRemoteSplitter,
QSplitter::handle#identitiesLocalRemoteSplitter,
QSplitter::handle#profilesLocalRemoteSplitter,
QSplitter::handle#whisperListsLocalRemoteSplitter {
	margin: 1.5px;
	background-image: url('styles:${folder}/splitter.png');
	background-repeat: no-repeat;
	background-position: center;
	height: 2px;
}

/* ------------------------------------------------------------------ */
/* Banners                                                             */
/* ------------------------------------------------------------------ */

QLabel#bookmarksBanner,
QLabel#identitiesBanner,
QLabel#accountLoginBanner,
QLabel#accountCreateBanner {
	background: ${bgSurface};
	border-bottom: 1px solid ${strokeDivider};
	color: ${textPrimary};
	padding-left: 12px;
	font-weight: 600;
	qproperty-minimumSize: 0px ${controlHeight}px;
}

QLabel#accountLoginBanner,
QLabel#accountCreateBanner {
	qproperty-minimumSize: 420px ${controlHeight}px;
}

/* ------------------------------------------------------------------ */
/* Menus & toolbar                                                     */
/* ------------------------------------------------------------------ */

/* Match the native caption on the main window. */
QMenuBar {
	background-color: ${bgCanvas};
	color: ${textPrimary};
	border-bottom: 1px solid ${strokeDivider};
	padding: 1px 4px;
}

QMenuBar::item {
	background: transparent;
	color: ${textPrimary};
	padding: ${gapTight}px ${gapNormal}px;
	border-radius: ${radiusControl}px;
}

QMenuBar::item:selected {
	background-color: ${fillHover};
}

QMenuBar::item:pressed {
	background-color: ${fillAccentSubtle};
}

QMenu {
	background-color: ${bgOverlay};
	color: ${textPrimary};
	border: 1px solid ${strokeOverlay};
	border-radius: ${radiusOverlay}px;
	padding: ${gapTight}px;
}

QMenu::item {
	background: transparent;
	color: ${textPrimary};
	padding: ${gapTight}px ${gapSection}px ${gapTight}px ${gapSection}px;
	border-radius: ${radiusControl}px;
}

QMenu::item:selected {
	background-color: ${fillSelected};
	color: ${textPrimary};
}

QMenu::item:disabled {
	color: ${textDisabled};
}

QMenu::separator {
	height: 1px;
	background: ${strokeDivider};
	margin: 5px 8px;
}

QToolBar {
	background-color: ${bgSurface};
	border: none;
	border-bottom: 1px solid ${strokeDivider};
	spacing: 2px;
	padding: ${gapTight}px ${gapNormal}px;
}

QToolButton {
	background: transparent;
	border: 1px solid transparent;
	border-radius: ${radiusControl}px;
	padding: 3px;
}

/* Remove the small dropdown triangles Qt draws on toolbar buttons that carry
   a menu. They add visual noise and are not used for discovery here. */
QToolButton::menu-indicator {
	/* `image: none` makes Qt fall back to the style's own arrow, so a
	   transparent image is the only reliable way to suppress it. */
	image: url('styles:${folder}/empty.png');
	width: 0px;
	height: 0px;
	border: none;
}

QToolButton::menu-arrow {
	image: url('styles:${folder}/empty.png');
	width: 0px;
	height: 0px;
}

QToolButton::menu-button {
	border: none;
	background: transparent;
	width: 0px;
}

/* TS3 also draws a menu arrow on push buttons that own a popup. */
QPushButton::menu-indicator {
	image: url('styles:${folder}/empty.png');
	width: 0px;
	height: 0px;
}

QToolButton:hover {
	background-color: ${fillHover};
}

QToolButton:pressed,
QToolButton:checked {
	background-color: ${fillAccentSubtle};
}

QToolButton:focus {
	border-color: ${focus};
}

QToolButton:disabled {
	background: transparent;
}

/* ------------------------------------------------------------------ */
/* Buttons                                                             */
/* ------------------------------------------------------------------ */

QPushButton {
	background-color: ${bgControl};
	color: ${textPrimary};
	border: 1px solid ${strokeControl};
	border-radius: ${radiusControl}px;
	padding: ${gapTight}px ${gapLoose}px;
	min-height: ${controlContentHeight}px;
}

QPushButton:hover {
	background-color: ${fillHover};
	border-color: ${strokeHover};
}

QPushButton:pressed {
	background-color: ${fillPressed};
}

QPushButton:focus {
	border-color: ${focus};
}

QPushButton:default {
	background-color: ${accent};
	color: ${textOnAccent};
	border-color: ${accent};
}

QPushButton:default:hover {
	background-color: ${accentHover};
	border-color: ${accentHover};
}

QPushButton:default:pressed {
	background-color: ${accentPressed};
	border-color: ${accentPressed};
}

QPushButton:default:focus {
	border-color: ${textOnAccent};
}

QPushButton:disabled, QPushButton:default:disabled {
	background-color: ${fillDisabled};
	color: ${textDisabled};
	border-color: ${strokeDisabled};
}

QPushButton:checked:enabled {
	background-color: ${fillSelected};
	color: ${accent};
	border-color: ${strokeSelected};
}

QPushButton:checked:focus:enabled {
	border-color: ${focus};
}

/* ------------------------------------------------------------------ */
/* Incoming poke dialog                                                */
/* ------------------------------------------------------------------ */

/* TS3 uses MsgDialog as the object name; scope by class to leave other
   message dialogs and the send-poke form alone. */
PokeDialog QLabel#serverLabel {
	color: ${textSecondary};
	font-size: ${captionSize}px;
	padding: 0 ${gapLoose}px;
}

/* The native browser already supplies a document inset and a transparent
   background. Don't give the read-only message an input field's frame. */
PokeDialog QTextBrowser#msgTextBrowser {
	border: none;
	padding: 0;
}

PokeDialog QDialogButtonBox#buttonBox {
	qproperty-centerButtons: false;
}

PokeDialog QDialogButtonBox#buttonBox QPushButton {
	background-color: ${bgControl};
	color: ${textPrimary};
	border-color: ${strokeControl};
	min-width: 56px;
}

PokeDialog QDialogButtonBox#buttonBox QPushButton:hover {
	background-color: ${fillHover};
	border-color: ${strokeHover};
}

PokeDialog QDialogButtonBox#buttonBox QPushButton:pressed {
	background-color: ${fillPressed};
}

PokeDialog QDialogButtonBox#buttonBox QPushButton:focus {
	border-color: ${focus};
}

/* ------------------------------------------------------------------ */
/* Inputs                                                              */
/* ------------------------------------------------------------------ */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
	background-color: ${bgInput};
	color: ${textPrimary};
	border: 1px solid ${strokeControl};
	border-radius: ${radiusControl}px;
	padding: ${gapTight}px ${gapNormal}px;
	selection-background-color: ${selectionBg};
	selection-color: ${selectionText};
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
	min-height: ${controlContentHeight}px;
}

/* Editable composites supply their own control frame. */
QAbstractSpinBox QLineEdit, QComboBox QLineEdit {
	min-height: 0;
	padding: 0;
	border: none;
	background: transparent;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
	background-color: ${bgInputFocus};
	border-color: ${focus};
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
	background-color: ${fillDisabled};
	color: ${textDisabled};
}

QComboBox::drop-down {
	border: none;
	width: 20px;
}

QComboBox QAbstractItemView {
	background-color: ${bgOverlay};
	color: ${textPrimary};
	border: 1px solid ${strokeOverlay};
	border-radius: ${radiusOverlay}px;
	padding: ${gapTight}px;
	outline: none;
	selection-background-color: ${fillSelected};
	selection-color: ${textPrimary};
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
	border: none;
	width: 16px;
	background: transparent;
}

/* ------------------------------------------------------------------ */
/* Scrollbars                                                          */
/* ------------------------------------------------------------------ */

QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 0;
}

QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 0;
}

QScrollBar::handle:vertical {
	background: ${scrollThumb};
	border: none;
	border-radius: 3px;
	min-height: 28px;
	margin: 0 2px;
}

QScrollBar::handle:horizontal {
	background: ${scrollThumb};
	border: none;
	border-radius: 3px;
	min-width: 28px;
	margin: 2px 0;
}

QScrollBar::handle:hover {
	background: ${scrollHover};
}

QScrollBar::handle:pressed {
	background: ${scrollPressed};
}

QScrollBar::add-line, QScrollBar::sub-line {
	width: 0;
	height: 0;
	border: none;
	background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}

/* ------------------------------------------------------------------ */
/* Server tree — no fills on items, selection is the only tint           */
/* ------------------------------------------------------------------ */

QTreeView#ServerTreeView {
	/* Leave a quiet surface behind status and group icons. */
	qproperty-alternatingRowColors: false;
	alternate-background-color: ${bgSidebar};
	qproperty-rootIsDecorated: false;
	background-color: ${bgSidebar};
	border: none;
	outline: none;
	color: ${textPrimary};
	font-family: "${fontFamily}";
	font-size: ${bodySize}px;
}

QTreeView {
	background-color: ${bgSurface};
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
	outline: none;
	color: ${textPrimary};
}

/* No `background` here on purpose: declaring one (even transparent) makes the
   style sheet paint the item itself and suppresses Qt's alternating row
   colours. Leaving it unset lets the base style fill normal and alternate
   rows, which is what produces the zebra pattern. */
QTreeView::item {
	min-height: 22px;
	padding: 1px 2px;
	border: none;
	color: ${textPrimary};
}

QTreeView::item:hover {
	background: transparent;
}

/* No automatic tint on channels. `::item:has-children` also matches channels
   that merely contain clients (clients are tree children too), so it colours
   occupied leaf channels — not what we want. There is no depth or child-type
   selector in Qt style sheets, so a permanent row tint cannot be limited to
   top-level channels. To emphasise a specific channel, upload the marker from
   dist/channel-icons/ to the server and pick it in the channel editor.
*/
/*
QTreeView#ServerTreeView::item:has-children {
	background-color: ${fillAccentSubtle};
}
*/

QTreeView#ServerTreeView::item:selected {
	background-color: ${fillSelected};
	color: ${textPrimary};
	border: none;
}

QTreeView::item:selected {
	background-color: ${fillSelected};
	color: ${textPrimary};
	border: none;
}

QTreeView::branch {
	background: transparent;
}

/* Explicit branch arrows: a bare `::branch` rule suppresses Qt's default
   arrow images, so the open/closed glyphs must be supplied by the theme. */
QTreeView::branch:has-children:closed {
	image: url('styles:${folder}/branch_closed.svg');
}

QTreeView::branch:has-children:open {
	image: url('styles:${folder}/branch_open.svg');
}

QTreeView::branch:has-children:closed:hover,
QTreeView::branch:has-children:open:hover {
	background: transparent;
}

/* ------------------------------------------------------------------ */
/* List / table views                                                  */
/* ------------------------------------------------------------------ */

QListView, QTableView, QTableWidget {
	background-color: ${bgSurface};
	color: ${textPrimary};
	alternate-background-color: ${bgSurface};
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
	gridline-color: ${strokeDivider};
	outline: none;
}

QListView::item, QTableView::item {
	padding: 3px 4px;
	border: none;
	background: transparent;
}

QListView::item:hover, QTableView::item:hover {
	background: transparent;
}

QListView::item:selected, QTableView::item:selected {
	background-color: ${fillSelected};
	color: ${textPrimary};
	border: none;
}

QListWidget#localIconsListWidget::item:selected,
QListWidget#remoteIconsListWidget::item:selected {
	background-color: ${fillAccentSubtle};
	border: 1px solid ${accent};
	border-radius: ${radiusControl}px;
}

QHeaderView {
	background: transparent;
}

QHeaderView::section {
	background-color: ${bgSurface};
	color: ${textSecondary};
	border: none;
	border-bottom: 1px solid ${strokeDivider};
	padding: 5px 8px;
	font-weight: 600;
}

/* ------------------------------------------------------------------ */
/* Tabs                                                                */
/* ------------------------------------------------------------------ */

QTabWidget::pane {
	border: none;
	border-top: 1px solid ${strokeDivider};
	top: -1px;
	background: ${bgSurface};
}

QTabBar {
	background: transparent;
}

/* Blend the chat tabs into the chat surface without a native baseline. */
QTabBar#ChatTabBar {
	qproperty-drawBase: false;
	background: ${bgSurface};
}

QTabBar::tab {
	background: transparent;
	color: ${textSecondary};
	border: none;
	border-bottom: 2px solid transparent;
	border-top-left-radius: ${radiusControl}px;
	border-top-right-radius: ${radiusControl}px;
	padding: ${gapTight}px 12px;
	margin-right: 2px;
}

QTabBar::tab:hover {
	background: ${fillHover};
	color: ${textPrimary};
}

QTabBar::tab:selected {
	color: ${accent};
	font-weight: 600;
	border-bottom: 2px solid ${accent};
}

/* Active chat highlighting must not change the label's metrics. */
QTabBar#ChatTabBar::tab {
	font-weight: 500;
}

QTabBar#ChatTabBar::tab:hover {
	background-color: transparent;
}

QTabBar#ChatTabBar::tab:!selected:hover {
	color: ${textSecondary};
}

QTabBar#ChatTabBar::tab {
	padding: ${gapTight}px 12px;
	margin-right: ${gapTight}px;
}

QTabWidget#ChatTabWidget::tab-bar {
	left: 12px;
}

QTabBar::close-button {
	image: url('styles:${folder}/tab_close.svg');
	subcontrol-position: right;
}

/* ------------------------------------------------------------------ */
/* Chat / info panes                                                   */
/* ------------------------------------------------------------------ */

QWidget#MainWindowChatWidget, QWidget#FlatCardHost {
	background-color: ${bgSurface};
}

QTabWidget#ChatTabWidget::pane {
	border: none;
	border-top: 1px solid ${strokeDivider};
	top: 0;
}

QTextEdit#InfoFrame {
	background-color: ${bgSurface};
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
	padding: ${gapNormal}px;
	color: ${textPrimary};
}

#FlatCardHost QTextEdit#InfoFrame {
	border: none;
	border-radius: 0;
	padding: ${gapNormal}px ${gapLoose}px;
}

QTextEdit#ChatTab {
	background-color: ${bgSurface};
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
	color: ${textPrimary};
	font-family: "${fontFamily}";
	font-size: ${bodySize}px;
}

QTextEdit#ChatLineEdit {
	background-color: ${bgInput};
	border: 1px solid ${strokeControl};
	border-bottom-color: ${strokeHover};
	border-radius: ${radiusControl}px;
	/* Fixed box: a height that tracks the document makes the caret jump
	   between lines while typing. */
	min-height: ${controlHeight}px;
	max-height: ${controlHeight}px;
	padding: 0 12px;
	margin: 0;
	color: ${textPrimary};
}

QTextEdit#ChatLineEdit:focus {
	background-color: ${bgInputFocus};
	border-color: ${strokeControl};
	border-bottom-color: ${strokeHover};
}

QTextEdit#ChatLineEdit[helpTextVisible="true"] {
	color: ${textTertiary};
}

QTextEdit#ChatLineEdit[helpTextVisible="false"] {
	color: ${textPrimary};
}

/* The stock emoticon toggle is replaced by the plugin's send button, and the
   input's own scrollbar strip read as a stray dark block. */
QToolButton#EmoticonButton {
	background: transparent;
	border: none;
	image: none;
	max-width: 0px;
	min-width: 0px;
	padding: 0;
	margin: 0;
}

QTextEdit#ChatLineEdit QScrollBar:vertical,
QTextEdit#ChatLineEdit QScrollBar:horizontal {
	background: transparent;
	width: 0px;
	height: 0px;
	margin: 0;
}


/* ------------------------------------------------------------------ */
/* Checkboxes & radio buttons                                          */
/* ------------------------------------------------------------------ */

QCheckBox, QRadioButton {
	background: transparent;
	color: ${textPrimary};
	spacing: ${gapNormal}px;
}

QCheckBox::indicator,
QTreeView::indicator,
QTableView::indicator,
QListView::indicator {
	width: 16px;
	height: 16px;
	border: 1px solid ${strokeHover};
	border-radius: 4px;
	background-color: ${bgSurface};
}

QCheckBox::indicator:hover,
QTreeView::indicator:hover,
QTableView::indicator:hover,
QListView::indicator:hover {
	border-color: ${scrollPressed};
}

QCheckBox::indicator:checked,
QTreeView::indicator:checked,
QTableView::indicator:checked,
QListView::indicator:checked {
	background-color: ${accent};
	border-color: ${accent};
	image: url('styles:${folder}/checkbox_check.svg');
}

QCheckBox::indicator:disabled,
QTreeView::indicator:disabled,
QTableView::indicator:disabled,
QListView::indicator:disabled {
	background-color: ${bgSurface};
	border-color: ${strokeDisabled};
}

QCheckBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled,
QTableView::indicator:checked:disabled,
QListView::indicator:checked:disabled {
	background-color: ${fillAccentDisabled};
	border-color: ${fillAccentDisabled};
}

QRadioButton::indicator {
	width: 15px;
	height: 15px;
	border: 1px solid ${strokeHover};
	border-radius: 8px;
	background-color: ${bgSurface};
}

QRadioButton::indicator:checked {
	background-color: ${bgSurface};
	border: 5px solid ${accent};
}

QRadioButton::indicator:disabled {
	border-color: ${strokeDisabled};
	background-color: ${bgSurface};
}

/* ------------------------------------------------------------------ */
/* Group boxes & sliders                                               */
/* ------------------------------------------------------------------ */

QGroupBox {
	background: transparent;
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
	margin-top: 10px;
	padding-top: 6px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 4px;
	color: ${textSecondary};
	background-color: ${bgCanvas};
}

QSlider::groove:horizontal {
	height: 4px;
	background: ${strokeDivider};
	border-radius: 2px;
}

QSlider::sub-page:horizontal {
	background: ${accent};
	border-radius: 2px;
}

QSlider::handle:horizontal {
	background: ${bgSurface};
	border: 1px solid ${strokeHover};
	width: 14px;
	height: 14px;
	margin: -6px 0;
	border-radius: 7px;
}

QSlider::handle:horizontal:hover {
	border-color: ${accent};
}

/* Qt hit-tests the groove itself, so expand it in the user volume dialog. */
UserVolumeWidget QSlider:horizontal {
	min-height: 24px;
}

UserVolumeWidget QSlider::groove:horizontal {
	height: 20px;
	border-radius: 10px;
}

UserVolumeWidget QSlider::sub-page:horizontal {
	border-radius: 10px;
}

UserVolumeWidget QSlider::handle:horizontal {
	width: 18px;
	height: 18px;
	margin: -2px 0;
	border-radius: 9px;
}

QProgressBar {
	background-color: ${fillDisabled};
	border: none;
	border-radius: 4px;
	height: 8px;
	text-align: center;
	color: ${textSecondary};
}

QProgressBar::chunk {
	background-color: ${accent};
	border-radius: 4px;
}

/* ------------------------------------------------------------------ */
/* Status bar                                                          */
/* ------------------------------------------------------------------ */

QStatusBar {
	background-color: ${bgSurface};
	border-top: 1px solid ${strokeDivider};
	color: ${textSecondary};
}

QStatusBar QLabel {
	padding: 0 ${gapTight}px;
	border: 0;
	font-size: ${captionSize}px;
	color: ${textSecondary};
	background: transparent;
}

QStatusBar::item {
	border: none;
}

/* ------------------------------------------------------------------ */
/* Options / about headlines                                           */
/* ------------------------------------------------------------------ */

QLabel#OptionsHeadlineTitleLabel {
	color: ${textPrimary};
	font-weight: 600;
	font-size: ${subtitleSize}px;
}

QLabel#OptionsHeadlineDescriptionLabel {
	color: ${textSecondary};
}

QLabel#NewsLeftLabel {
	padding-right: 6px;
}

QLabel#appNameLabel {
	color: ${textPrimary};
	font-weight: 600;
	font-size: ${subtitleSize}px;
}

QWidget#HeadlineLabel {
	background-color: ${bgSurface};
	border-bottom: 1px solid ${strokeDivider};
}

/* ------------------------------------------------------------------ */
/* Server integrations                                                 */
/* ------------------------------------------------------------------ */

com--teamspeak--ui--ServerIntegrationsWidget QWidget#ExistingServerIntegration,
com--teamspeak--ui--ServerIntegrationsWidget QWidget#AvailableServerIntegration {
	background: ${fillAccentSubtle};
	border-radius: ${radiusOverlay}px;
}

com--teamspeak--ui--ServerIntegrationsWidget com--teamspeak--ui--IntegrationResponseWidget {
	background: ${bgSurface};
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
}

com--teamspeak--ui--ServerIntegrationsWidget com--teamspeak--ui--IntegrationBubble {
	background: ${bgSurface};
	border: 1px solid ${strokeDivider};
	border-radius: ${radiusOverlay}px;
}

com--teamspeak--ui--IntegrationBubbleEditable QComboBox#IntegrationBubbleEditableComboBox {
	border: 1px solid ${strokeControl};
	background: ${bgSurface};
	border-radius: ${radiusControl}px;
	padding: 2px 9px;
}

com--teamspeak--ui--ServerIntegrationsWidget com--teamspeak--ui--ErrorIndicator {
	background: ${fillDanger};
	border: none;
	border-radius: ${radiusControl}px;
}

com--teamspeak--ui--ErrorIndicator QLabel#IntegrationErrorIndicatorLabel {
	font-weight: 600;
	color: ${textOnDanger};
}
